## 底部按钮布局模式

### 间距规范
- **按钮到屏幕边缘边距**：16pt
- **按钮之间水平间距**：8pt
- **距 Safe Area 底部**：12pt

### 模式1：单个主操作按钮（高度 44）
```objective-c
UIButton *confirmButton = [UIButton buttonWithType:UIButtonTypeCustom];
confirmButton.backgroundColor = Color_blue;
[confirmButton setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
confirmButton.titleLabel.font = [UIFont systemFontOfSize:16.0f];
confirmButton.layer.cornerRadius = 4.0f;
[confirmButton setTitle:@"确认提交" forState:UIControlStateNormal];

[confirmButton mas_makeConstraints:^(MASConstraintMaker *make) {
    make.height.mas_equalTo(44.0f);
    make.left.mas_equalTo(containerView.mas_left).with.offset(16.0f);
    make.right.mas_equalTo(containerView.mas_right).with.offset(-16.0f);
    make.bottom.mas_equalTo(containerView.mas_safeAreaLayoutGuideBottom).with.offset(-12.0f);
}];
```

### 模式2：取消 + 主操作组合（高度 32）
```objective-c
UIButton *cancelButton = [UIButton buttonWithType:UIButtonTypeCustom];
cancelButton.backgroundColor = [UIColor whiteColor];
cancelButton.layer.borderColor = Color_border.CGColor;
cancelButton.layer.borderWidth = 1.5f;
[cancelButton setTitleColor:ColorText_0 forState:UIControlStateNormal];
cancelButton.titleLabel.font = [UIFont systemFontOfSize:14.0f];
cancelButton.layer.cornerRadius = 4.0f;
[cancelButton setTitle:@"取消" forState:UIControlStateNormal];

UIButton *confirmButton = [UIButton buttonWithType:UIButtonTypeCustom];
confirmButton.backgroundColor = Color_blue;
[confirmButton setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
confirmButton.titleLabel.font = [UIFont systemFontOfSize:14.0f];
confirmButton.layer.cornerRadius = 4.0f;
[confirmButton setTitle:@"确认" forState:UIControlStateNormal];

[cancelButton mas_makeConstraints:^(MASConstraintMaker *make) {
    make.height.mas_equalTo(32.0f);
    make.left.mas_equalTo(containerView.mas_left).with.offset(16.0f);
    make.bottom.mas_equalTo(containerView.mas_safeAreaLayoutGuideBottom).with.offset(-12.0f);
}];

[confirmButton mas_makeConstraints:^(MASConstraintMaker *make) {
    make.height.mas_equalTo(32.0f);
    make.left.mas_equalTo(cancelButton.mas_right).with.offset(8.0f);
    make.right.mas_equalTo(containerView.mas_right).with.offset(-16.0f);
    make.bottom.mas_equalTo(containerView.mas_safeAreaLayoutGuideBottom).with.offset(-12.0f);
    make.width.mas_equalTo(cancelButton.mas_width);
}];
```

### 模式3：三按钮组合（高度 28）
```objective-c
UIButton *leftButton = [UIButton buttonWithType:UIButtonTypeCustom];
leftButton.backgroundColor = [UIColor whiteColor];
leftButton.layer.borderColor = Color_border.CGColor;
leftButton.layer.borderWidth = 1.0f;
[leftButton setTitleColor:ColorText_0 forState:UIControlStateNormal];
leftButton.titleLabel.font = [UIFont systemFontOfSize:12.0f];
leftButton.layer.cornerRadius = 4.0f;

UIButton *centerButton = [UIButton buttonWithType:UIButtonTypeCustom];
centerButton.backgroundColor = [UIColor whiteColor];
centerButton.layer.borderColor = Color_border.CGColor;
centerButton.layer.borderWidth = 1.0f;
[centerButton setTitleColor:ColorText_0 forState:UIControlStateNormal];
centerButton.titleLabel.font = [UIFont systemFontOfSize:12.0f];
centerButton.layer.cornerRadius = 4.0f;

UIButton *rightButton = [UIButton buttonWithType:UIButtonTypeCustom];
rightButton.backgroundColor = Color_blue;
[rightButton setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
rightButton.titleLabel.font = [UIFont systemFontOfSize:12.0f];
rightButton.layer.cornerRadius = 4.0f;

NSArray *buttons = @[leftButton, centerButton, rightButton];
[buttons mas_distributeViewsAlongAxis:MASAxisTypeHorizontal
                    withFixedSpacing:8.0f
                         leadSpacing:16.0f
                         tailSpacing:16.0f];
[buttons mas_makeConstraints:^(MASConstraintMaker *make) {
    make.height.mas_equalTo(28.0f);
    make.bottom.mas_equalTo(containerView.mas_safeAreaLayoutGuideBottom).with.offset(-12.0f);
}];
```

