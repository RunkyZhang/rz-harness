## 数据和方法规范

### 数据结构
```javascript
data() {
  return {
    loading: false,
    operate: false, // 操作权限
    searchForm: {
      // 搜索表单字段
    },
    tableData: [],
    page: 1,
    rows: 10,
    total: 0,
    multipleSelection: [], // 选中的行
    sortName: null,
    sortType: '',
    dateRange: [], // 日期范围
    exportLoading: false // 下载中心异步导出时使用，见「列表导出」
  }
}
```

### 必需方法
```javascript
methods: {
  // 获取数据
  fetchData() {
    // 数据获取逻辑
  },

  // 搜索
  searchClick() {
    this.page = 1
    this.fetchData()
  },

  // 重置
  handleReset() {
    // 重置搜索条件和分页
    this.searchForm = {}
    this.page = 1
    this.rows = 10
    this.dateRange = []
    this.sortName = null
    this.sortType = ''
    this.multipleSelection = []
    this.$refs.multipleTable.clearSort()
    this.fetchData()
  },

  // 分页大小改变
  handleSizeChange(val) {
    this.rows = val
    this.page = 1
    this.fetchData()
  },

  // 当前页改变
  handleCurrentChange(val) {
    this.page = val
    this.fetchData()
  },

  // 选择行改变
  handleSelectionChange(val) {
    this.multipleSelection = val
  },

  // 排序改变
  sortChange(column) {
    if (!column.order) {
      this.sortName = null
      this.sortType = null
      this.fetchData()
      return
    }
    this.sortName = column.prop
    this.sortType = column.order === 'ascending' ? 'asc' : 'desc'
    this.fetchData()
  }
}
```

