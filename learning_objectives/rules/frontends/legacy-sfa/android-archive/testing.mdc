# 测试规范

## 测试策略

### 单元测试
针对业务逻辑和工具类：

```kotlin
class UserManagerTest {

    @Test
    fun `getUserInfo should return user when valid id provided`() {
        // Given
        val userId = "123"
        val expectedUser = UserBean(id = userId, name = "测试用户")

        // When
        val result = userManager.getUserInfo(userId)

        // Then
        assertEquals(expectedUser, result)
    }

    @Test
    fun `getUserInfo should return null when invalid id provided`() {
        // Given
        val invalidUserId = ""

        // When
        val result = userManager.getUserInfo(invalidUserId)

        // Then
        assertNull(result)
    }
}
```

### 协程测试
```kotlin
@ExperimentalCoroutinesApi
class NetworkManagerTest {

    @get:Rule
    val mainCoroutineRule = MainCoroutineRule()

    @Test
    fun `fetchData should handle network error gracefully`() = runTest {
        // Given
        val mockApiService = mockk<ApiService>()
        coEvery { mockApiService.getData() } throws IOException("Network error")

        // When
        val result = networkManager.fetchData()

        // Then
        assertTrue(result.isFailure)
    }
}
```

### UI 测试（Instrumentation）
```kotlin
@RunWith(AndroidJUnit4::class)
class LoginActivityTest {

    @get:Rule
    val activityRule = ActivityScenarioRule(LoginActivity::class.java)

    @Test
    fun loginButtonShouldBeEnabledWhenFormIsValid() {
        // Given
        onView(withId(R.id.et_username)).perform(typeText("testuser"))
        onView(withId(R.id.et_password)).perform(typeText("password123"))

        // When & Then
        onView(withId(R.id.btn_login)).check(matches(isEnabled()))
    }
}
```

## Mock 策略

### Repository 层 Mock
```kotlin
class MockUserRepository : UserRepository {
    override suspend fun getUser(id: String): Result<UserBean> {
        return when (id) {
            "valid_id" -> Result.success(UserBean(id = id, name = "Mock User"))
            else -> Result.failure(Exception("User not found"))
        }
    }
}
```

### ViewModel 测试
```kotlin
class UserViewModelTest {

    private lateinit var viewModel: UserViewModel
    private lateinit var mockRepository: UserRepository

    @Before
    fun setup() {
        mockRepository = mockk()
        viewModel = UserViewModel(mockRepository)
    }

    @Test
    fun `loadUser should update userInfo when repository returns success`() = runTest {
        // Given
        val expectedUser = UserBean(id = "123", name = "Test User")
        coEvery { mockRepository.getUser(any()) } returns Result.success(expectedUser)

        // When
        viewModel.loadUser("123")

        // Then
        assertEquals(expectedUser, viewModel.userInfo.value)
    }
}
```

